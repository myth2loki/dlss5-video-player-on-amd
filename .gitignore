# Build output
/build*/
/out/
# A staged runnable copy of the player (exe + ffmpeg + neural-runtime/), assembled
# by hand for testing on this machine - never a source deliverable.
/run-fg/
/CMakeFiles/
/CMakeCache.txt
/cmake_install.cmake
/*.sln
/*.vcxproj*

# Downloaded dependencies / local runtime packs
/external/*
!/external/youtube/
/external/youtube/*
!/external/youtube/README.md
# The two Optical Flow interface headers carry their own MIT notice, scoped to the
# file, so unlike the DLSS SDK they can live here and the build needs no download.
!/external/nvof/
/external/nvof/*
!/external/nvof/nvOpticalFlowCommon.h
!/external/nvof/nvOpticalFlowD3D12.h
# The NVENC API header is under the same kind of file-scoped MIT notice, pinned from
# FFmpeg's nv-codec-headers (THIRD_PARTY.md has the tag and its SHA-256).
!/external/nvenc/
/external/nvenc/*
!/external/nvenc/nvEncodeAPI.h
/external/runtime/
/streamline/
/Streamline/

# AMD Lmxxf neural runtime pack: third-party runtime DLL, user-supplied weights and
# HSACO modules, staged locally under amd-neural-runtime/ (606 MB, checksums in the
# SHA256SUMS manifests that ship inside it). Never redistributed, never committed.
/amd-neural-runtime/

# The same pack copied aside for a second experiment ("- 副本" and friends). It is the
# same 600 MB of binaries the rule above keeps out; a copy is not a different argument.
/amd-neural-runtime - 副本/
/amd-neural-runtime copy/
/amd-neural-runtime.backup/
# Only the files a payload swap overwrites (modules, shaders, the runtime DLL, the
# config dir) - the 575 MB of weights are byte-identical across 0.43 and 0.44 and
# are not copied. Kept beside the pack so a swap can be undone file for file.
/amd-neural-runtime.bak-044/

# Screenshot dumps from manual A/B eyeballing.
/_style-shots/

# Runtime files that should not be committed
*.dll
*.exe
*.pdb
*.ilk
*.lib
*.exp
*.addon64
ReShade.ini
ReShadePreset.ini
# ...except the two packaged templates, which are inputs rather than runtime output:
# build_windows.bat and tools/package_release.ps1 both copy them out of packaging/.
!/packaging/ReShade.ini
!/packaging/ReShadePreset.ini
DLSSVideoPlayer.ini
DLSSVideoPlayer.log
ReShade.log
/dist/
# tools/release_notes.ps1 writes it here for the release workflow's publish step.
/release-notes.md
/cache/

# Local archives / generated checksums
*.zip
*.7z
*.rar
*.sha256
*_SHA256.txt

# IDE / OS
.worktrees/
.vs/
.vscode/
.idea/
*.user
*.suo
Thumbs.db
.DS_Store

# Python bytecode from the benchmark tools
__pycache__/

# Project website build output (site/README.md explains the build)
site/dist/

# Impeccable working files; the surface brief under .impeccable/surfaces/ is kept
.impeccable/review/
.impeccable/analysis/
.impeccable/mocks/
.impeccable/brief-body.md

# Browser-automation session logs (Playwright MCP) written into the working directory
/.playwright-mcp/

# AMD Lmxxf smoke output written next to the working directory: the stage A probe
# frame, the stage B evaluator frames, and any captured run log. Regenerate with
# the corresponding smoke; one rule covers the family so a new smoke cannot
# quietly start committing megabytes of PNG.
/amd-lmxxf-*.png
/amd-lmxxf-*.log
# The guide dumps an A/B of the AMD estimator writes: one .pfm per frame per arm,
# in a directory per arm. Same family as the PNGs above, same reason.
/amd-lmxxf-pan-guides-*/

# Translation engine + GGUF (downloaded on first use, ~2.7 GB)
/translation/

# Speech recognition runtime + GGML model (downloaded on first use)
/asr/
